{
    "name": "projectsaturnstudios/venusian-stargazer",
    "description": "National Aeronautics and Space Administration (NASA) integration for Venusian Framework applications.",
    "type": "library",
    "version": "0.9.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5",
        "venusian-voyager/http": "^0.9.1",
        "venusian-voyager/io-pools": "^0.9.1",
        "venusian-voyager/nuts-and-bolts": "^0.9.1"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4",
        "venusian-voyager/config": "^0.9.0",
        "venusian-voyager/vessel": "^0.9.0"
    },
    "autoload": {
        "psr-4": {
            "ProjectSaturnStudios\\Stargazer\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "venusian": {
            "providers": [
                "ProjectSaturnStudios\\Stargazer\\Providers\\StargazerServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "test-coverage": "XDEBUG_MODE=coverage pest --coverage",
        "test-coverage-html": "XDEBUG_MODE=coverage pest --coverage --coverage-html=tests/coverage",
        "test-coverage-text": "XDEBUG_MODE=coverage pest --coverage --coverage-text",
        "test-coverage-clover": "XDEBUG_MODE=coverage pest --coverage --coverage-clover=tests/coverage.xml"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
